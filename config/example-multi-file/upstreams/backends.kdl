// Upstream pools. Splitting these out keeps target churn away from routing.

upstreams {
    upstream "api" {
        target "127.0.0.1:9001" weight=1
        target "127.0.0.1:9002" weight=1
        load-balancing "round-robin"
    }

    upstream "static" {
        target "127.0.0.1:9003"
    }
}
