// TLS listener.
//
// Note: per-SNI certificate serving, client-auth and cipher-suite selection
// are parsed but not yet applied by the listener (issue #303); the listener
// serves the primary certificate to all clients. Zentinel warns loudly at
// startup when such settings are configured.

listeners {
    listener "https" {
        address "0.0.0.0:8443"
        protocol "https"

        tls {
            cert-file "/etc/zentinel/certs/example.crt"
            key-file "/etc/zentinel/certs/example.key"
            min-version "TLS1.2"
        }
    }
}
